{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node", "lib": ["ES2023"],
    "strict": true, "strictPropertyInitialization": false, "esModuleInterop": true, "skipLibCheck": true,
    "experimentalDecorators": true, "emitDecoratorMetadata": true, "outDir": "dist", "rootDir": "src",
    "sourceMap": true, "types": ["node", "multer"]
  },
  "include": ["src"]
}
