{
  "name": "eazazi-lead-instagram",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "setup": "pnpm install && node scripts/dev.mjs --setup-only",
    "dev": "node scripts/dev.mjs",
    "db": "node scripts/db.mjs",
    "db:backup": "node scripts/backup.mjs",
    "build": "pnpm -C apps/api build && pnpm -C apps/web build",
    "start": "node scripts/dev.mjs --prod",
    "test": "pnpm -C apps/api test && pnpm -C apps/web test",
    "desktop:dist": "pnpm -C apps/web build:desktop && pnpm -C apps/desktop dist"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "electron",
      "@embedded-postgres/windows-x64",
      "@nestjs/core"
    ]
  },
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19"
  }
}
