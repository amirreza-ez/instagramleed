# ---- Core ----
NODE_ENV=development
PORT=4000
WEB_PORT=5173
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,app://eazazi

# ---- Database ----
# EMBEDDED_PG=true starts a bundled PostgreSQL automatically (local / single machine).
EMBEDDED_PG=true
PG_PORT=54329
PG_PASSWORD=eazazi
DATABASE_URL=postgresql://postgres:eazazi@127.0.0.1:54329/eazazi
TEST_DATABASE_URL=postgresql://postgres:eazazi@127.0.0.1:54329/eazazi_test

# ---- Security (generated automatically on first run) ----
JWT_SECRET=__RANDOM_32__
ENCRYPTION_KEY=__RANDOM_32__

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@eazazi.ir
SEED_ADMIN_PASSWORD=Eazazi@12345

# ---- Meta (fill after creating an app at developers.facebook.com) ----
META_GRAPH_VERSION=v24.0
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=__RANDOM_16__

# ---- Payments ----
# manual | zarinpal
PAYMENT_PROVIDER=manual
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
